  /// Versão selada mais recente; o histórico completo fica em `sealedVersions`.
  finalSha256    String?
  sentAt         DateTime            @default(now())
  sealedAt       DateTime?
  sealedVersions RevalleSealedHash[]
}

/// REVALLE: histórico dos hashes finais. Uma linha por selagem (a reselagem acrescenta, nunca sobrescreve).
