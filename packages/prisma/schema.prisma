enum RevalleInvoiceStatus {
  YES
  NO
  UNKNOWN
}

enum RevalleInvoiceDetectedBy {
  TEXT
  SENDER
}

enum RevalleSuggestionStatus {
  PENDING
  DONE
  FAILED
  SKIPPED
}

/// REVALLE: se o documento é nota fiscal, a sugestão da IA, a conta escolhida (`choiceCode`) e, desde a
/// Fase 6, a aprovação do Financeiro e as versões. A conta aprovada entra no certificado e no /verificar, e a conta vista
/// por quem assina fica na prova de cada assinatura (`RevalleSignatureProof.invoiceAccount`).
model RevalleInvoiceClassification {
  envelopeId                String                   @id
  envelope                  Envelope                 @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  isInvoice                 RevalleInvoiceStatus
  detectedBy                RevalleInvoiceDetectedBy
  /// Quem trocou a marcação "é nota fiscal" pela última vez e quando (sem FK, como choiceById).
  flagChangedById           Int?
  flagChangedAt             DateTime?
  signals                   String[]
  fileSha256                String?
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  suggestionStatus          RevalleSuggestionStatus  @default(SKIPPED)
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  suggestion                Json?
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  suggestionAttempts        Int                      @default(0)
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  /// Fase 8: o que a IA leu da NF junto com a sugestão (podem estar errados, a tela diz que vieram da IA). Valor em
  /// centavos; nulos quando a IA não leu, a sugestão falhou ou o arquivo mudou.
  supplierName              String?
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  invoiceNumber             String?
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  totalAmountCents          Int?
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  /// Fase 8: chaves de acesso válidas (44 dígitos, modelos 55, 57, 65 e 67) achadas no texto dos arquivos da NF e, na NF
  /// escaneada, a que a IA leu. Duas NFs com uma chave em comum são a mesma nota. Vazio quando o arquivo não tem chave.
  accessKeys                String[]                 @default([])
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  choiceCode                String?
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  choiceById                Int?
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  choiceAt                  DateTime?
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  acceptedSuggestion        Boolean?
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  /// Fase 7: centro de custo (lista fixa no código, `cost-centers.ts`), escolhido pela pessoa, com quem e quando (sem FK).
  costCenterCode            String?
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  costCenterById            Int?
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  costCenterAt              DateTime?
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  /// Fase 7: a Contabilidade validou o centro: quando, quem (sem FK) e o nome congelado. Não segura a conclusão.
  costCenterValidatedAt     DateTime?
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  costCenterValidatedById   Int?
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  costCenterValidatedByName String?
  /// Fase 6: aprovação do Financeiro. Nulo = não é NF (ou NF ainda em rascunho); `LEGACY` = NF de antes da Fase 6.
  financeStatus             RevalleFinanceStatus?
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  /// Quem do Financeiro aprovou (ou definiu) a conta e quando (sem FK, como choiceById).
  approvedById              Int?
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  approvedAt                DateTime?
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  /// Nome da conta aprovada, congelado na aprovação (a lista pode ser reimportada com outro nome). Nulo = usa o atual.
  approvedAccountName       String?
  /// Espelho (Fase 9): gravado só por syncInvoiceEnvelopeMirror.
  /// Nome de quem aprovou (ou definiu), congelado no mesmo momento. Nulo = usa o nome atual.
  approvedByName            String?
  /// Versão substituída por outra (conta trocada pelo Financeiro ou centro corrigido pela Contabilidade): quando, quem,
  /// o motivo, o que mudou e a nova versão.
  supersededAt              DateTime?
  supersededById            Int?
  supersedeReason           String?
  supersedeKind             RevalleSupersedeKind?
  supersededByEnvelopeId    String?
  /// Fase 9: com 2+ notas, o arquivo (item desta versão) cuja conta ou centro mudou na nova versão.
  supersededEnvelopeItemId  String?
  /// Versão anterior (esta é a v2, v3…). Sem FK: a ligação fica também no log de auditoria das duas versões.
  previousEnvelopeId        String?
  version                   Int                      @default(1)
  /// Conta e centro no PDF: true = envio de antes do bloco (ou nova versão dele), a selagem escreve o texto sozinha
  /// acima da primeira assinatura de cada nota. false = só onde o remetente pôs o bloco "Conta e centro de custo".
  autoAnnotation            Boolean                  @default(false)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  // Fase 8: a busca da nota duplicada (mesma chave ou mesmo arquivo).
  @@index([accessKeys], type: Gin)
  @@index([fileSha256])
}

/// REVALLE: sugestão da IA por SHA-256 do arquivo (o mesmo arquivo nunca é enviado ao Gemini duas vezes).
model RevalleInvoiceSuggestionCache {
  fileSha256 String   @id
  suggestion Json
  model      String
  createdAt  DateTime @default(now())
}

/// REVALLE (Fase 9): o que cada arquivo do envio é. `UNKNOWN` = PDF sem texto, o remetente diz o que é.
enum RevalleInvoiceFileKind {
  NF
  BOLETO
  OTHER
  UNKNOWN
}

/// REVALLE (Fase 9): uma linha por arquivo do envio. Fonte de verdade de tudo que é "da nota" (IA, dados lidos, conta,
/// centro, validação da Contabilidade e aprovação do Financeiro). A linha do envio (`RevalleInvoiceClassification`) guarda
/// o espelho (cópia da nota única; nulo com várias), gravado só por `syncInvoiceEnvelopeMirror`.
model RevalleInvoiceFile {
  id                        String                   @id @default(cuid())
  envelopeId                String
  envelope                  Envelope                 @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  envelopeItemId            String                   @unique
  envelopeItem              EnvelopeItem             @relation(fields: [envelopeItemId], references: [id], onDelete: Cascade)
  kind                      RevalleInvoiceFileKind
  detectedBy                RevalleInvoiceDetectedBy @default(TEXT)
  /// Quem disse o tipo do arquivo (o remetente) e quando (sem FK, como choiceById).
  kindChangedById           Int?
  kindChangedAt             DateTime?
  signals                   String[]                 @default([])
  /// SHA-256 deste arquivo (o PDF enviado, `initialData`).
  fileSha256                String?
  suggestionStatus          RevalleSuggestionStatus  @default(SKIPPED)
  /// NF: como na linha do envio; BOLETO: { ...BoletoData, model } ou { failure }.
  suggestion                Json?
  suggestionAttempts        Int                      @default(0)
  supplierName              String?
  invoiceNumber             String?
  totalAmountCents          Int?
  accessKeys                String[]                 @default([])
  /// Dados do boleto (beneficiário, CNPJ, valor, vencimento, linha digitável).
  boletoData                Json?
  choiceCode                String?
  choiceById                Int?
  choiceAt                  DateTime?
  acceptedSuggestion        Boolean?
  costCenterCode            String?
  costCenterById            Int?
  costCenterAt              DateTime?
  costCenterValidatedAt     DateTime?
  costCenterValidatedById   Int?
  costCenterValidatedByName String?
  approvedById              Int?
  approvedAt                DateTime?
  approvedAccountName       String?
  approvedByName            String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([envelopeId])
  @@index([accessKeys], type: Gin)
  @@index([fileSha256])
}

/// REVALLE (Fase 9): dados do boleto lidos pela IA, por SHA-256 do arquivo (o mesmo boleto nunca vai ao Gemini duas vezes).
model RevalleBoletoCache {
  fileSha256 String   @id
  data       Json
  model      String
  createdAt  DateTime @default(now())
}

/// REVALLE: estado da NF no Financeiro (Fase 6). Os `DocumentStatus` do upstream não mudam.
enum RevalleFinanceStatus {
  PENDING_APPROVAL
  APPROVED
  SUPERSEDED
  LEGACY
}

/// REVALLE: o que mudou numa versão substituída (Fase 7).
enum RevalleSupersedeKind {
  ACCOUNT
  COST_CENTER
}

/// REVALLE: quem é do perfil Financeiro (marcado pelo admin em Admin → Perfis), sem mudar o enum `Role` do upstream.
model RevalleFinanceMember {
  userId    Int      @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Admin que marcou (sem FK, como choiceById).
  addedById Int?
  createdAt DateTime @default(now())
}

/// REVALLE: quem é do perfil Contabilidade (Fase 7, marcado pelo admin em Admin → Perfis), igual ao Financeiro: tabela
/// própria, sem mudar o enum `Role` do upstream. A pessoa pode ter os dois perfis.
model RevalleAccountingMember {
  userId    Int      @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Admin que marcou (sem FK, como choiceById).
  addedById Int?
  createdAt DateTime @default(now())
}

/// REVALLE: CPF informado no cadastro (Fase 7), guardado só até o e-mail ser confirmado. Quando confirma, o CPF vira
/// `RevalleEmailLink` e esta linha é apagada. O CPF não fica em `User`. Sem `@unique`: dois cadastros não confirmados
/// podem trazer o mesmo CPF (quem confirmar primeiro fica com o vínculo).
model RevalleSignupIdentity {
  userId    Int      @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cpf       String
  createdAt DateTime @default(now())
}

/// REVALLE: termo de responsabilidade de equipamento criado pela integração com o Patrimônio. A linha marca o envelope
/// como termo: só ele aceita signatário fora dos domínios da empresa e tem regras próprias no portão (o CPF digitado
/// tem de ser `signerCpf`, sem vínculo e-mail ↔ CPF). `signerCpf` fica completo, como no vínculo.
/// `activeExternalId` = `externalId` enquanto o termo está pendente (nulo depois): o índice único impede dois termos
/// pendentes com o mesmo `externalId`, também em pedidos simultâneos.
model RevallePatrimonioTermo {
  envelopeId       String    @id
  envelope         Envelope  @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  externalId       String
  activeExternalId String?   @unique
  kind             String // ENTREGA | DEVOLUCAO
  signerCpf        String
  createdAt        DateTime  @default(now())
  cancelledAt      DateTime?
  cancelReason     String?
  lastResendAt     DateTime?

  @@index([externalId])
}

/// REVALLE: avisos (webhook) ao Patrimônio, um por mudança de estado do termo (`id` = `eventId`), com as tentativas de
/// entrega. Sem FK: a trilha das entregas fica mesmo se o envelope for apagado. Nunca leva CPF.
model RevallePatrimonioEvent {
  id            String    @id
  envelopeId    String
  event         String
  payload       Json
  createdAt     DateTime  @default(now())
  deliveredAt   DateTime?
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  lastError     String?

  @@unique([envelopeId, event])
  @@index([deliveredAt, nextAttemptAt])
}

/// REVALLE: o bloco "Conta e centro de custo" que o remetente põe no editor. Um por arquivo; a selagem escreve a conta e
/// o centro da nota dentro dele (só em arquivo NF). Página a partir de 1; posição e tamanho em % da página, como `Field`.
model RevalleInvoiceAnnotationBox {
  envelopeItemId String       @id
  envelopeItem   EnvelopeItem @relation(fields: [envelopeItemId], references: [id], onDelete: Cascade)
  envelopeId     String
  envelope       Envelope     @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  page           Int
  positionX      Float
  positionY      Float
  width          Float
  height         Float
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([envelopeId])
}

/// REVALLE (v.21): modelo marcado como "contrato para colaboradores". Nasce de um documento concluído (o representante da
/// empresa já assinou): `sourceEnvelopeId` e o código de verificação do representante ficam guardados, com o nome e a
/// data da assinatura dele congelados para o certificado de cada colaborador. Sem FK na origem: a referência fica mesmo
/// se o documento do representante for apagado. Apagar o modelo só solta `templateEnvelopeId` (a marca dos documentos já
/// criados continua valendo); a fila desse contrato para de sair.
model RevalleCollaboratorContract {
  id                     String                  @id @default(cuid())
  templateEnvelopeId     String?                 @unique
  templateEnvelope       Envelope?               @relation("RevalleCollaboratorContractTemplate", fields: [templateEnvelopeId], references: [id], onDelete: SetNull)
  sourceEnvelopeId       String
  sourceVerificationCode String
  representativeName     String
  representativeSignedAt DateTime
  createdById            Int
  paused                 Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  uploads                RevalleBulkSendUpload[]
  queue                  RevalleBulkSendQueue[]

  @@index([sourceEnvelopeId])
}

/// REVALLE (v.21): uma planilha enviada para um contrato para colaboradores. As linhas (nome e e-mail, já sem repetidos)
/// ficam aqui, e não no payload do job (que vai para o log). `processedRows` é o ponto em que o job parou: um novo
/// disparo continua dali (a varredura da fila dispara de novo a planilha parada).
model RevalleBulkSendUpload {
  id            String                      @id @default(cuid())
  contractId    String
  contract      RevalleCollaboratorContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdById   Int
  rows          Json
  totalRows     Int
  duplicateRows Int
  processedRows Int                         @default(0)
  createdCount  Int                         @default(0)
  skippedCount  Int                         @default(0)
  failedCount   Int                         @default(0)
  /// Quem está criando os documentos agora (renovado a cada linha). Outro disparo só entra depois que ele vence.
  leaseUntil    DateTime?
  completedAt   DateTime?
  createdAt     DateTime                    @default(now())
  /// Avança a cada linha: parada há mais de 15 minutos sem terminar = o job caiu (a varredura dispara de novo).
  updatedAt     DateTime                    @updatedAt

  @@index([contractId])
  @@index([completedAt, updatedAt])
}

enum RevalleBulkSendStatus {
  QUEUED
  SENT
  FAILED
}

/// REVALLE (v.21): documento criado de um contrato para colaboradores. A linha é a marca "sem conta" do documento e a
/// fila de envio em lotes. A dispensa de conta (e o CPF sempre no portão) vale só para `recipientId` e só enquanto o
/// e-mail dele continua `email` (normalizado); um e-mail por contrato. `lastErrorCode` é só o código, nunca dado pessoal.
model RevalleBulkSendQueue {
  id            String                      @id @default(cuid())
  envelopeId    String                      @unique
  recipientId   Int                         @unique
  email         String
  envelope      Envelope                    @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  contractId    String
  contract      RevalleCollaboratorContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  status        RevalleBulkSendStatus       @default(QUEUED)
  attempts      Int                         @default(0)
  lastErrorCode String?
  lockedAt      DateTime?
  sentAt        DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@unique([contractId, email])
  @@index([contractId, status])
  @@index([status, createdAt])
}
