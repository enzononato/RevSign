  termVersion                String?
  termAcceptedAt             DateTime?
  termIpAddress              String?
  termUserAgent              String?
  identityStatus             String    @default("PENDING") // PENDING | VERIFIED | CONFIRMED | LINKED | SKIPPED
  pendingCpf                 String?
  cpf                        String?
  identityConfirmedAt        DateTime?
  failedAttempts             Int       @default(0)
  codeFailedAttempts         Int       @default(0)
  lockedAt                   DateTime?
  lockReason                 String? // ATTEMPTS | CPF_CONFLICT | CODE_ATTEMPTS
  conflictCpf                String?
  /// Fase 6: número da conta contábil da NF que a página de assinatura mostrou (a prova só congela a conta mostrada).
  invoiceAccountShownCode    String?
  /// Fase 7: código do centro de custo da NF que a página de assinatura mostrou (congelado só se for o atual).
  invoiceCostCenterShownCode String?
