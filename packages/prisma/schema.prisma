  userAgent         String?
  device            String?
  ipLocation        Json?
  deviceLocation    Json
  drewSignature     Boolean
  signatureKind     String // IMAGE | TYPED | NONE
  /// Fase 6: { code, name } da conta contábil da NF vista ao assinar (congelada). Nula em documento comum.
  invoiceAccount    Json?
  /// Fase 7: { code, name } do centro de custo da NF visto ao assinar (congelado). Nulo em NF sem centro e em documento comum.
  invoiceCostCenter Json?
  /// Fase 9: com 2+ notas, por arquivo de nota, a conta e o centro vistos ao assinar (congelados): uma lista de
  /// envelopeItemId, title, index, total, account e costCenter. Nula com uma nota (valem as duas colunas de cima).
