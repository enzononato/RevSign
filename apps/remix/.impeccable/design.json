  "narrative": {
    "northStar": "O Engradado",
    "overview": "Cada documento é um engradado retornável: tem encaixes, e cada encaixe se enche quando alguém assina. Casca azul royal moldada, conteúdo em papel quente e cartões brancos macios; o azul só aparece onde existe algo a fazer.",
    "keyCharacteristics": [
      "Casca azul royal com grade de 24px",
      "Chão quente, cartões raio 20, pílulas 999",
      "Nunito Sans 900 nos títulos, Figtree na interface",
      "Estado pela forma, não só pela cor",
      "Profundidade por contorno e régua"
    ],
    "rules": [
      {
        "name": "The Action-Only Blue Rule",
        "body": "Azul sólido significa que há algo a fazer agora.",
        "section": "colors"
      },
      {
        "name": "The One Amber Rule",
        "body": "O âmbar existe só para o contador de pendências.",
        "section": "colors"
      },
      {
        "name": "The Pair Rule",
        "body": "Todo status é fundo lavado + texto escuro da mesma família.",
        "section": "colors"
      },
      {
        "name": "The Heavy Headline Rule",
        "body": "Só h1, h2, números de destaque e iniciais de encaixe usam Nunito Sans pesada.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Valores, contadores e datas usam algarismos tabulares.",
        "section": "typography"
      },
      {
        "name": "The Ridge Rule",
        "body": "Cheio e clicável tem régua escura por baixo; vazado tem contorno interno.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do usar azul só para ação, filtro restringente, encaixe cheio, item ativo e foco.",
      "Do mostrar andamento com encaixes e manter o estado legível sem cor.",
      "Do usar os tokens em vez de hex e testar nos dois temas.",
      "Do manter uma ação por linha e um botão primário por visão.",
      "Do respeitar prefers-reduced-motion."
    ],
    "donts": [
      "Don't usar azul em texto corrido ou situação passiva.",
      "Don't voltar à tabela cinza com selos coloridos.",
      "Don't usar o âmbar fora do contador.",
      "Don't usar --primary como cor de texto no escuro.",
      "Don't usar sombra difusa ou dura deslocada.",
      "Don't esconder o link Código-fonte (AGPL-3.0)."
