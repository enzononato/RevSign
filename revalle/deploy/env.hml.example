# RevSign — variáveis de homologação (MODELO: só nomes e placeholders).
#
# Os valores reais ficam no EasyPanel (aba Environment do serviço) e numa cópia
# no cofre de senhas. Nunca neste repositório.
#
# Gerar segredos:  openssl rand -hex 32
# Certificado:     base64 -w0 cert.p12   (ver revalle/docs/certificado.md)

# --- Valores fixos (iguais em homologação e produção) ---
PORT=3000
NODE_ENV=production
TZ=America/Bahia
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://localhost:3000
NEXT_PUBLIC_UPLOAD_TRANSPORT=database
NEXT_PRIVATE_JOBS_PROVIDER=local
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SIGNING_TRANSPORT=local
DOCUMENSO_DISABLE_TELEMETRY=true
NEXT_PUBLIC_REVALLE_SOURCE_URL=https://github.com/enzononato/RevSign
# Cadastro (e, na Fase 3, signatários) só destes domínios, separados por vírgula.
NEXT_PRIVATE_ALLOWED_SIGNUP_DOMAINS=revalle.com.br,revallenordeste.com.br,revallepe.com.br

# --- Banco (serviço Postgres dedicado no EasyPanel) ---
POSTGRES_PASSWORD=<openssl rand -hex 32>
# No EasyPanel, o host é o nome interno do serviço Postgres:
# NEXT_PRIVATE_DATABASE_URL=postgres://documenso:<senha>@<projeto>_<servico-postgres>:5432/documenso
# NEXT_PRIVATE_DIRECT_DATABASE_URL=<mesmo valor>

# --- App ---
NEXT_PUBLIC_WEBAPP_URL=https://assinatura-hml.<dominio>
NEXTAUTH_SECRET=<openssl rand -hex 32>
NEXT_PRIVATE_ENCRYPTION_KEY=<openssl rand -hex 32>
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=<openssl rand -hex 32>
# Cadastro aberto: a restrição é feita por NEXT_PRIVATE_ALLOWED_SIGNUP_DOMAINS.
NEXT_PUBLIC_DISABLE_SIGNUP=false

# --- SMTP do cPanel ---
# Porta 465 => SECURE=true (TLS direto). Porta 587 => SECURE=false (STARTTLS).
NEXT_PRIVATE_SMTP_HOST=<mail.dominio>
NEXT_PRIVATE_SMTP_PORT=465
NEXT_PRIVATE_SMTP_SECURE=true
NEXT_PRIVATE_SMTP_USERNAME=<conta@dominio>
NEXT_PRIVATE_SMTP_PASSWORD=<senha da conta de e-mail>
NEXT_PRIVATE_SMTP_FROM_NAME=Revalle Assinaturas
NEXT_PRIVATE_SMTP_FROM_ADDRESS=<conta@dominio>

# --- Certificado de assinatura ---
NEXT_PRIVATE_SIGNING_LOCAL_FILE_CONTENTS=<base64 do .p12, uma linha>
NEXT_PRIVATE_SIGNING_PASSPHRASE=<senha do .p12>

# --- Só no ensaio local ---
# REVSIGN_IMAGE=revsign:local-<sha>
